{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "src": "^/boss(?:/|/index\\.html)?$",
      "dest": "/api/view-report?path=tenders.html"
    },
    {
      "src": "^/boss/tenders\\.html$",
      "dest": "/api/view-report?path=tenders.html"
    },
    {
      "src": "^/boss/(.*)$",
      "dest": "/api/view-report?path=$1"
    }
  ]
}

